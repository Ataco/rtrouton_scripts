// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH MODELS
// ============================================

model User {
  id            String   @id @default(uuid())
  auth0Id       String   @unique
  email         String   @unique
  firstName     String
  lastName      String
  role          Role     @relation(fields: [roleId], references: [id])
  roleId        String
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  assignedCases     OrganMatch[]       @relation("CoordinatorAssignments")
  surgeonNotes      SurgeonNote[]
  chatMessages      ChatMessage[]
  auditLogs         AuditLog[]
  shiftRecords      ShiftRecord[]
  createdWorkflows  WorkflowTemplate[] @relation("WorkflowCreator")

  @@index([email])
  @@index([auth0Id])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json     // Array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

// ============================================
// CASE & DONOR MANAGEMENT
// ============================================

model DonorCase {
  id                String   @id @default(uuid())
  donorId           String   @unique
  donorHospital     String?
  donorOPO          String?
  donorAge          Int?
  donorBloodType    String?
  causeOfDeath      String?
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  organMatches      OrganMatch[]
  donorSummaries    DonorSummary[]
  chatMessages      ChatMessage[]

  @@index([donorId])
  @@index([status])
  @@map("donor_cases")
}

model OrganMatch {
  id                 String   @id @default(uuid())
  donorCase          DonorCase @relation(fields: [donorCaseId], references: [id], onDelete: Cascade)
  donorCaseId        String
  matchId            String   // External match ID from OPO
  organType          OrganType
  recipientHospital  String?
  recipientSurgeon   String?
  status             String   @default("OFFERED") // OFFERED, ACCEPTED, DECLINED, COMPLETED
  assignedCoordinator User?   @relation("CoordinatorAssignments", fields: [coordinatorId], references: [id])
  coordinatorId      String?
  workflowStage      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  reportingRecords    ReportingRecord[]
  surgeonNotes        SurgeonNote[]
  preservationSegments PreservationSegment[]
  transportRecords    TransportRecord[]
  analytics           OrganAnalytics?
  workflowProgress    WorkflowProgress[]

  @@unique([donorCaseId, matchId, organType])
  @@index([organType])
  @@index([status])
  @@index([coordinatorId])
  @@map("organ_matches")
}

enum OrganType {
  HEART
  LUNG
  LIVER
  KIDNEY
  PANCREAS
  HEART_LUNG
}

model DonorSummary {
  id              String    @id @default(uuid())
  donorCase       DonorCase @relation(fields: [donorCaseId], references: [id], onDelete: Cascade)
  donorCaseId     String
  matchId         String?
  fileName        String
  fileUrl         String
  parsedMetadata  Json      // All parsed fields from PDF
  organHighlights Json?     // Key organ-relevant fields
  uploadedAt      DateTime  @default(now())
  uploadedBy      String?

  @@index([donorCaseId])
  @@map("donor_summaries")
}

// ============================================
// WORKFLOW TEMPLATES
// ============================================

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String   // RECIPIENT, RECOVERY
  organType   OrganType?
  stages      Json     // Array of stage objects with conditions
  isActive    Boolean  @default(true)
  createdBy   User     @relation("WorkflowCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([organType])
  @@map("workflow_templates")
}

model WorkflowProgress {
  id            String      @id @default(uuid())
  organMatch    OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId  String
  currentStage  String
  completedStages Json      // Array of completed stage IDs
  stageData     Json        // Stage-specific data
  updatedAt     DateTime    @updatedAt

  @@index([organMatchId])
  @@map("workflow_progress")
}

// ============================================
// REPORTING FORMS
// ============================================

model ReportingRecord {
  id            String      @id @default(uuid())
  organMatch    OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId  String
  formType      String      // RECOVERY_ONCALL, THORACIC, LIVER, KIDNEY, LUNG, PANCREAS
  formData      Json        // All form fields
  submittedAt   DateTime    @default(now())
  submittedBy   String
  version       Int         @default(1)

  @@index([organMatchId])
  @@index([formType])
  @@map("reporting_records")
}

// ============================================
// COORDINATOR TOOLS
// ============================================

model ShiftRecord {
  id              String   @id @default(uuid())
  coordinator     User     @relation(fields: [coordinatorId], references: [id])
  coordinatorId   String
  shiftStart      DateTime
  shiftEnd        DateTime?
  inheritedCases  Json?    // Array of case IDs inherited
  handedOffCases  Json?    // Array of case IDs handed off
  notes           String?
  createdAt       DateTime @default(now())

  @@index([coordinatorId])
  @@index([shiftStart])
  @@map("shift_records")
}

// ============================================
// SURGEON NOTES
// ============================================

model SurgeonNote {
  id            String      @id @default(uuid())
  organMatch    OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId  String
  author        User        @relation(fields: [authorId], references: [id])
  authorId      String
  content       String
  isPrivate     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([organMatchId])
  @@index([authorId])
  @@map("surgeon_notes")
}

// ============================================
// CHAT & COLLABORATION
// ============================================

model ChatMessage {
  id            String      @id @default(uuid())
  donorCase     DonorCase   @relation(fields: [donorCaseId], references: [id], onDelete: Cascade)
  donorCaseId   String
  author        User        @relation(fields: [authorId], references: [id])
  authorId      String
  content       String
  messageType   String      @default("USER") // USER, SYSTEM, AUTO_SUMMARY
  attachments   Json?       // Array of file URLs
  tags          Json?       // Array of tagged user IDs
  createdAt     DateTime    @default(now())

  @@index([donorCaseId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================
// TRANSPORT & LOGISTICS
// ============================================

model TransportRecord {
  id              String      @id @default(uuid())
  organMatch      OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId    String
  tailNumber      String?
  carrier         String?
  departureAirport String?
  arrivalAirport  String?
  departureTime   DateTime?
  arrivalTime     DateTime?
  estimatedArrival DateTime?
  actualArrival   DateTime?
  trackingStatus  String?     // SCHEDULED, IN_FLIGHT, LANDED, DELAYED
  coordinates     Json?       // Current lat/lng from tracking API
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([organMatchId])
  @@index([tailNumber])
  @@map("transport_records")
}

// ============================================
// PRESERVATION & ISCHEMIA TRACKING
// ============================================

model PreservationSegment {
  id            String      @id @default(uuid())
  organMatch    OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId  String
  phase         String      // COLD, WARM
  modality      String      // ICE, STATIC_COLD_ADV, HMP, NMP
  isOxygenated  Boolean     @default(false)
  temperature   Float?
  startTime     DateTime
  endTime       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([organMatchId])
  @@index([phase])
  @@map("preservation_segments")
}

model PreservationTolerance {
  id            String      @id @default(uuid())
  organType     OrganType   @unique
  modality      String
  maxColdTime   Int         // Minutes
  maxWarmTime   Int         // Minutes
  description   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([organType, modality])
  @@map("preservation_tolerances")
}

// ============================================
// ANALYTICS
// ============================================

model OrganAnalytics {
  id                    String      @id @default(uuid())
  organMatch            OrganMatch  @relation(fields: [organMatchId], references: [id], onDelete: Cascade)
  organMatchId          String      @unique
  totalColdIschemia     Int?        // Minutes
  totalWarmIschemia     Int?        // Minutes
  perfusionModalities   Json?       // History of modalities used
  transportDuration     Int?        // Minutes
  clampTime             DateTime?
  reperfusionTime       DateTime?
  preservationScore     Float?      // Calculated quality score
  riskFactors           Json?       // Array of identified risks
  lastCalculated        DateTime    @default(now())

  @@index([organMatchId])
  @@map("organ_analytics")
}

model PreservationAnalytics {
  id            String      @id @default(uuid())
  organType     OrganType
  modality      String
  totalCold     Int         // Minutes
  totalWarm     Int         // Minutes
  caseCount     Int
  averageScore  Float?
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime    @default(now())

  @@index([organType])
  @@index([modality])
  @@index([periodStart])
  @@map("preservation_analytics")
}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id            String   @id @default(uuid())
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  action        String   // CREATE, UPDATE, DELETE, VIEW, EXPORT
  resource      String   // Resource type (e.g., "OrganMatch", "ReportingRecord")
  resourceId    String?  // ID of the affected resource
  changes       Json?    // Before/after for updates
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================
// ADMIN CONFIGURATION
// ============================================

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_config")
}
