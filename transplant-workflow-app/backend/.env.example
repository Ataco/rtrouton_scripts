# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/transplant_db?schema=public"

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# JWT Secret (for internal tokens if needed)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173

# Plane Tracking API (example: AviationStack, FlightAware, etc.)
FLIGHT_API_KEY=your-flight-api-key
FLIGHT_API_URL=https://api.aviationstack.com/v1

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=2555
